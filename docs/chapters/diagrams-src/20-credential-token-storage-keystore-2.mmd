classDiagram
    class SecureStore {
        <<interface>>
        +put(key, secret)
        +get(key) String?
        +remove(key)
        +clear()
    }
    class KeystoreSecureStore {
        -DataStore blobStore
        -String keyAlias
        +put(key, secret)
        +get(key) String?
    }
    class TokenStore {
        <<interface>>
        +current() Tokens?
        +update(...)
        +clear()
    }
    SecureStore <|.. KeystoreSecureStore
    TokenStore ..> SecureStore
