flowchart TD
    APP["app code"] --> STORE["SecureStore"]
    STORE --> GEN["get-or-create Keystore key (alias)"]
    GEN --> KS["Android Keystore (TEE/StrongBox) - key non-extractable"]
    STORE --> ENC["AES-GCM encrypt secret (key used, not exported)"]
    ENC --> BLOB["store IV + ciphertext in DataStore/file"]
    STORE --> DEC["AES-GCM decrypt on read"]
    AUTHBIND["setUserAuthenticationRequired"] -.->|sensitive| KS
    BIO["BiometricPrompt (Ch 21)"] -.->|unlock auth-bound key| KS
    BACKUP["backup rules: exclude"] -.-> BLOB
