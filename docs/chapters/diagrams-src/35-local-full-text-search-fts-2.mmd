        <<Fts4 external-content=ProductEntity>>
        +String title
        +String brand
        +String description
    }
    class ProductSearchDao {
        +search(match) List~ProductResult~
        +rebuildIndex()
    }
    ProductFts ..> ProductEntity : indexes
