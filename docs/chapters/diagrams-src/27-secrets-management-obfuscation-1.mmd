flowchart TD
    SECRET["a value"] --> CLASS{"classification"}
    CLASS -->|true secret| SERVER["server-side only - never in APK"]
    CLASS -->|3rd-party client key| RESTRICT["restricted + revocable key (package+sig+API limits)"]
    CLASS -->|non-secret config| CONFIG["BuildConfig / remote config"]
    RESTRICT --> BUILD["build-time injection from CI/secrets (not VCS)"]
    CONFIG --> BUILD
    PERSIST["persisted on-device secret (token)"] --> KS["Keystore-encrypted (Ch 20)"]
    BUILD --> R8["R8: shrink + optimize + obfuscate (+ keep rules)"]
    R8 --> MAP["retain mapping file (Ch 83)"]
    DEPTH["defense-in-depth: integrity (Ch 26), pinning (Ch 23)"] -.-> R8
